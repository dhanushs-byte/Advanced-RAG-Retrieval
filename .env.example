# Copy this file to .env. API access is OPTIONAL.
USE_LLM=false

# OpenAI-compatible endpoint (example: OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=liquid/lfm-3-1.7b:free

# Set these only if your provider publishes per-1M-token prices.
# They are used to estimate cost; leave at 0 for free models.
INPUT_COST_PER_1M=0
OUTPUT_COST_PER_1M=0

# Embedding model (downloaded once and cached by Hugging Face)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Existing Week7-Day1 corpus folder, relative to this project folder.
# The default expects D:\Training\Week_7\Week7-Day1\data
DATA_DIR=../Week7-Day1/data

CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=3
